# Server
MUSICDECK_HOST=127.0.0.1
MUSICDECK_PORT=4534
MUSICDECK_PUBLIC_URL=http://localhost:4534
MUSICDECK_CORS_ORIGIN=http://localhost:3000
MUSICDECK_SESSION_SECRET=change-this-in-development
MUSICDECK_SESSION_SECRET_FILE=
MUSICDECK_DB_PATH=./data/musicdeck.sqlite

# First-start admin creation. Only used when the users table is empty.
MUSICDECK_ADMIN_USERNAME=admin
MUSICDECK_ADMIN_PASSWORD=

# Initial backend provider
MUSICDECK_BACKEND=navidrome
NAVIDROME_URL=http://SERVER_IP:4533
NAVIDROME_USERNAME=navidrome-username-here
NAVIDROME_PASSWORD=navidrome-password-here
NAVIDROME_PASSWORD_FILE=

# Relative to MUSICDECK_MUSIC_ROOT; must be inside Navidrome's PlaylistsPath
# if that setting restricts playlist auto-import.
MUSICDECK_SPOTIFY_IMPORT_SUBDIR=Spotify Imports

# Optional Jellyfin provider (type = "jellyfin"). Authenticates via the
# X-Emby-Token header; the key is never placed in URLs or logs.
JELLYFIN_URL=
JELLYFIN_API_KEY=
