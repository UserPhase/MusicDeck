# Server
MUSICDECK_HOST=127.0.0.1
MUSICDECK_PORT=4534
MUSICDECK_PUBLIC_URL=http://localhost:4534
# For Google Cast, this origin must be reachable by the receiver (trusted HTTPS recommended).
MUSICDECK_CORS_ORIGIN=http://localhost:3000
MUSICDECK_SESSION_SECRET=change-this-in-development
MUSICDECK_SESSION_SECRET_FILE=
MUSICDECK_DB_PATH=./data/musicdeck.sqlite

# All admitted login attempts count in fixed windows, including successes.
MUSICDECK_LOGIN_WINDOW_MS=900000
MUSICDECK_LOGIN_IP_MAX=20
MUSICDECK_LOGIN_ACCOUNT_MAX=10
MUSICDECK_LOGIN_MAX_CONCURRENT=4
MUSICDECK_LOGIN_MAX_ENTRIES=10000
# Empty = ignore forwarding headers. Only allow actual proxy IPs/CIDRs.
MUSICDECK_TRUSTED_PROXIES=

# Acquisition limits per process; terminal history only, never active jobs.
MUSICDECK_ACQUISITION_MAX_PENDING=50
MUSICDECK_ACQUISITION_MAX_PENDING_PER_USER=10
MUSICDECK_ACQUISITION_SUBMISSION_WINDOW_MS=60000
MUSICDECK_ACQUISITION_SUBMISSIONS_PER_USER=20
MUSICDECK_ACQUISITION_SUBMISSIONS_GLOBAL=100
MUSICDECK_ACQUISITION_MAX_RATE_ENTRIES=10000
MUSICDECK_ACQUISITION_RETENTION_MS=604800000
MUSICDECK_ACQUISITION_MAX_RETAINED_JOBS=1000
MUSICDECK_ACQUISITION_CLEANUP_INTERVAL_MS=60000
MUSICDECK_ACQUISITION_SSE_PER_USER=3
MUSICDECK_ACQUISITION_SSE_GLOBAL=20

# First-start admin creation. Only used when the users table is empty.
MUSICDECK_ADMIN_USERNAME=admin
MUSICDECK_ADMIN_PASSWORD=

# Initial backend provider
MUSICDECK_BACKEND=navidrome
NAVIDROME_URL=http://SERVER_IP:4533
NAVIDROME_USERNAME=navidrome-username-here
NAVIDROME_PASSWORD=navidrome-password-here
NAVIDROME_PASSWORD_FILE=

# Relative to MUSICDECK_MUSIC_ROOT; holds Spotify source metadata only.
MUSICDECK_SPOTIFY_IMPORT_SUBDIR=Spotify Imports

# Trusted server code only; mount reviewed extension folders here (read-only).
MUSICDECK_EXTENSIONS_DIR=./extensions

# Optional overrides for native metadata repair (defaults to spotDL's Python and FFmpeg's sibling ffprobe/PATH).
# Python must have Mutagen installed; the Docker image installs it via requirements.txt.
MUSICDECK_TAGGER_PYTHON=
FFPROBE_PATH=

# Optional Jellyfin provider (type = "jellyfin"). Authenticates via the
# X-Emby-Token header; the key is never placed in URLs or logs.
JELLYFIN_URL=
JELLYFIN_API_KEY=
