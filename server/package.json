{
  "name": "musicdeck-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "tsx src/scripts/init-db.ts",
    "library:shrink": "tsx src/scripts/shrink-library.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "nanoid": "^6.0.1",
    "node-cron": "^4.6.0",
    "tar-stream": "^3.2.2",
    "ws": "^8.18.3",
    "zod": "^4.6.6"
  },
  "overrides": {
    "fast-uri": "^4.2.3",
    "ajv": {
      "fast-uri": "^3.1.9"
    }
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
