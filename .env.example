# ---------------------------------------------------------------------------
# MusicDeck — self-hosted configuration
#
# A complete production install is just two files:
#
#   docker-compose.yml   (pulls prebuilt images from GHCR)
#   .env                 (this file)
#
# Copy this file to `.env` next to docker-compose.yml. Most settings already
# have sane, working defaults (shown commented out) — you only need to change
# the handful marked "Required": your LAN IP, your music folder, and your
# secrets/passwords. Then:
#
#   docker compose pull
#   docker compose up -d
#
# You do NOT need the MusicDeck source repository, and you do NOT need to
# install Node.js, Python, FFmpeg, or spotDL on the host — they are already
# inside the MusicDeck server image.
# ---------------------------------------------------------------------------

# ===== Music backend (choose exactly one) =====

# Which music backend MusicDeck runs against: navidrome or jellyfin.
# Only the selected backend's container is started; the other one is never
# created. Only that backend's credentials below are required.
MUSIC_BACKEND=navidrome

# Leave this exactly as-is. It makes Docker Compose start only the backend
# selected above, so you configure the choice in ONE place (MUSIC_BACKEND).
COMPOSE_PROFILES=${MUSIC_BACKEND}

# ===== Network =====

# Public web port for the MusicDeck web container. This is the ONLY port
# LAN clients need to know — API, artwork, streaming, downloads, and admin
# pages are all reverse-proxied through this single origin.
MUSICDECK_WEB_PORT=8080

# Required: the URL LAN clients will actually type into their browser,
# e.g. http://192.168.1.50:8080 — replace with your server's LAN IP (or
# hostname) and MUSICDECK_WEB_PORT above. Do NOT leave this as localhost
# for a real deployment; only devices on the server itself could reach it.
MUSICDECK_PUBLIC_URL=http://SERVER_IP:8080

# Optional: defaults to MUSICDECK_PUBLIC_URL above. Only set this
# separately if browsers reach MusicDeck through a different origin than
# MUSICDECK_PUBLIC_URL (uncommon — leave commented out otherwise).
# MUSICDECK_CORS_ORIGIN=http://SERVER_IP:8080

# Set to "true" only if this stack sits behind a reverse proxy that
# terminates HTTPS. Plain HTTP LAN deployments must leave this "false" or
# login sessions will silently fail to persist (browsers drop Secure
# cookies sent over non-HTTPS connections).
MUSICDECK_SECURE_COOKIES=false

# ===== Secrets and first-run admin =====

# Required: use a long random value in real deployments (e.g.
# `openssl rand -hex 32`). Session cookies for every logged-in user are
# signed with this — treat it as a real secret.
MUSICDECK_SESSION_SECRET=replace-with-a-long-random-secret

# First-start admin account. Used only while the MusicDeck users table is
# empty; this is the account you use to sign in and create further users
# (each with their own isolated session/settings/playlists/history).
MUSICDECK_ADMIN_USERNAME=admin
MUSICDECK_ADMIN_PASSWORD=change-this-admin-password

# Linux user/group IDs that MusicDeck Server uses when writing MUSIC_ROOT.
# Set these to the owner of your host music folder. For a normal Linux login,
# run `id -u` and `id -g` on the Docker host (both are commonly 1000).
PUID=1000
PGID=1000

# ===== Navidrome (required when MUSIC_BACKEND=navidrome) =====

# Navidrome service credentials used by MusicDeck Server to talk to
# Navidrome over the internal Docker network (http://navidrome:4533).
# Create this account in Navidrome's own UI on first run.
# Do not reuse these as end-user/browser credentials.
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=change-this-navidrome-password

# Optional: publish Navidrome's own port on the host for direct
# setup/admin access (e.g. creating the NAVIDROME_USERNAME account on first
# run). Not required for normal MusicDeck use.
NAVIDROME_PORT=4533

# ===== Jellyfin (required when MUSIC_BACKEND=jellyfin) =====

# Jellyfin API key used by MusicDeck Server over the internal Docker
# network (http://jellyfin:8096). Create it under
# Jellyfin Dashboard -> API Keys after completing Jellyfin's first-run
# wizard. Required only when MUSIC_BACKEND=jellyfin.
JELLYFIN_API_KEY=

# Optional: publish Jellyfin's own port on the host for direct setup/admin
# access (needed at least once to create the API key above).
JELLYFIN_PORT=8096

# ===== Host storage paths =====

# Required: your music library. Mounted read-write into MusicDeck Server
# (so downloads land here) and read-only into the selected backend (so it
# can scan/serve it without ever modifying it). Must be an absolute path
# on the Docker host and writable by PUID:PGID above.
MUSIC_ROOT=/media/music

# Optional: the selected backend's own database/config/cache (all separate
# from your music files). These default to folders created next to
# docker-compose.yml, so they work as-is with no edits. Override with
# absolute host paths if you'd rather store them elsewhere.
# NAVIDROME_DATA=./navidrome-data
# JELLYFIN_CONFIG=./jellyfin-config
# JELLYFIN_CACHE=./jellyfin-cache

# ===== Image selection (advanced) =====

# Which published MusicDeck image version to run. Pin to a release tag
# (e.g. 1.2.0) for reproducible deployments instead of tracking latest.
# MUSICDECK_VERSION=latest

# Override only if you host your own image builds.
# MUSICDECK_IMAGE_SERVER=ghcr.io/userphase/musicdeck-server
# MUSICDECK_IMAGE_WEB=ghcr.io/userphase/musicdeck-web

# NOTE: MusicDeck's own SQLite database, users, sessions, settings,
# favorites, recently played, and playlists live in the Docker named
# volumes musicdeck-data / musicdeck-config / musicdeck-cache, managed by
# Compose (not host paths) — see `docker volume inspect musicdeck-data` if
# you need the underlying location for backups.
