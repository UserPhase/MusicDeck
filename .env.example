# Public web port for the MusicDeck web container.
MUSICDECK_WEB_PORT=8080
MUSICDECK_PUBLIC_URL=http://localhost:8080
MUSICDECK_CORS_ORIGIN=http://localhost:8080

# Required: use a long random value in real deployments.
MUSICDECK_SESSION_SECRET=replace-with-a-long-random-secret

# Set to "true" only if you are serving this stack over HTTPS (e.g. behind a
# reverse proxy with TLS). Plain HTTP deployments must leave this "false" or
# login sessions will silently fail to persist (browsers drop Secure cookies
# sent over non-HTTPS connections).
MUSICDECK_SECURE_COOKIES=false

# First-start admin creation. Used only while the MusicDeck users table is empty.
MUSICDECK_ADMIN_USERNAME=admin
MUSICDECK_ADMIN_PASSWORD=change-this-admin-password

# Navidrome service credentials used by MusicDeck Server.
# Do not reuse these as public/browser credentials.
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=change-this-navidrome-password

# Optional direct Navidrome host port for initial Navidrome setup/admin access.
NAVIDROME_PORT=4533

# NOTE: The music library folder and Navidrome's own data folder are fixed
# host paths in docker-compose.yml (/media/music and /opt/navidrome/data),
# matching a typical standalone Navidrome server deployment. MusicDeck Server
# mounts the same /media/music folder read-write so files downloaded via
# On-Demand Library/spotDL land exactly where Navidrome scans from. Edit
# docker-compose.yml directly if your host paths differ.
