# ---------------------------------------------------------------------------
# Copy this file to `.env` in the same folder as docker-compose.yml, then
# edit every value below (host paths, ports, secrets, credentials) for your
# server. After that, `docker compose up -d` is the only command needed.
# ---------------------------------------------------------------------------

# ===== Network =====

# Public web port for the MusicDeck web container. This is the ONLY port
# LAN clients need to know — API, artwork, streaming, downloads, and admin
# pages are all reverse-proxied through this single origin.
MUSICDECK_WEB_PORT=8080

# The URL LAN clients will actually type into their browser, e.g.
# http://192.168.1.50:8080 — replace with your server's LAN IP (or
# hostname) and MUSICDECK_WEB_PORT above. Do NOT leave this as localhost
# for a real deployment; only devices on the server itself could reach it.
MUSICDECK_PUBLIC_URL=http://SERVER_IP:8080

# Must exactly match MUSICDECK_PUBLIC_URL (same scheme/host/port).
MUSICDECK_CORS_ORIGIN=http://SERVER_IP:8080

# Set to "true" only if this stack sits behind a reverse proxy that
# terminates HTTPS. Plain HTTP LAN deployments must leave this "false" or
# login sessions will silently fail to persist (browsers drop Secure
# cookies sent over non-HTTPS connections).
MUSICDECK_SECURE_COOKIES=false

# ===== Secrets and first-run admin =====

# Required: use a long random value in real deployments (e.g.
# `openssl rand -hex 32`). Session cookies for every logged-in user are
# signed with this — treat it as a real secret.
MUSICDECK_SESSION_SECRET=replace-with-a-long-random-secret

# First-start admin account. Used only while the MusicDeck users table is
# empty; this is the account you use to sign in and create further users
# (each with their own isolated session/settings/playlists/history).
MUSICDECK_ADMIN_USERNAME=admin
MUSICDECK_ADMIN_PASSWORD=change-this-admin-password

# ===== Navidrome (internal service account) =====

# Navidrome service credentials used by MusicDeck Server to talk to
# Navidrome over the internal Docker network (http://navidrome:4533).
# Do not reuse these as end-user/browser credentials.
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=change-this-navidrome-password

# Optional: publish Navidrome's own port on the host for direct
# setup/admin access (e.g. creating the NAVIDROME_USERNAME account on first
# run). Not required for normal MusicDeck use — remove the `ports:` entry
# in docker-compose.yml if you don't want Navidrome reachable directly.
NAVIDROME_PORT=4533

# ===== Jellyfin (optional, internal service account) =====

# Jellyfin is optional. If you don't use it, leave JELLYFIN_API_KEY blank;
# MusicDeck simply won't have a Jellyfin connection available to enable.
# Create an API key under Jellyfin Dashboard -> API Keys after first login.
JELLYFIN_API_KEY=

# Optional: publish Jellyfin's own port on the host for direct setup/admin
# access. Not required for normal MusicDeck use.
JELLYFIN_PORT=8096

# ===== Host storage paths =====
#
# These MUST be absolute paths on the Docker host. Create the folders
# before starting the stack if they don't already exist.

# Your music library. Mounted read-write into MusicDeck Server (so
# downloads land here) and read-only into Navidrome/Jellyfin (so they can
# scan/serve it without ever modifying it).
MUSIC_ROOT=/media/music

# Navidrome's own database/config/cache (separate from your music files).
NAVIDROME_DATA=/opt/navidrome/data

# Jellyfin's own config and transcode/image cache (separate from your
# music files).
JELLYFIN_CONFIG=/opt/jellyfin/config
JELLYFIN_CACHE=/opt/jellyfin/cache

# NOTE: MusicDeck's own SQLite database, users, sessions, settings,
# favorites, recently played, and playlists live in the Docker named
# volumes musicdeck-data / musicdeck-config / musicdeck-cache, managed by
# Compose (not host paths) — see `docker volume inspect musicdeck-data` if
# you need the underlying location for backups.
